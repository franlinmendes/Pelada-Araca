rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function isAdmin() {
      return signed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Perfis. Usuário comum só altera nome, idade e posição; admin altera tudo.
    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && (
        isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.admin == false &&
         request.resource.data.mensalista == false));
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'idade', 'pos']));
      allow delete: if isAdmin();
    }

    // Nota e velocidade: só admin enxerga e altera.
    match /ratings/{uid} {
      allow read, write: if isAdmin();
    }

    // Contatos para notificação: só admin.
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // Peladas: todos leem, só admin cria/edita.
    match /peladas/{pid} {
      allow read: if signed();
      allow write: if isAdmin();

      // Presença: cada um muda a própria (só com a pelada aberta); admin muda a de qualquer um.
      match /rsvps/{uid} {
        allow read: if signed();
        allow create, update: if isAdmin() || (
          request.auth.uid == uid &&
          request.resource.data.by == uid &&
          request.resource.data.intent in ['dentro', 'fora'] &&
          get(/databases/$(database)/documents/peladas/$(pid)).data.status == 'aberta');
        allow delete: if isAdmin();
      }
    }
  }
}
