rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function fotoOk() {
      return !('foto' in request.resource.data) ||
        (request.resource.data.foto is string && request.resource.data.foto.size() < 30000);
    }
    function isAdmin() {
      return signed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Perfis. Usuário comum só altera nome, idade e posição; admin altera tudo.
    match /users/{uid} {
      allow read: if signed();
      allow create: if signed() && fotoOk() && (
        isAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.admin == false &&
         request.resource.data.mensalista == false));
      allow update: if isAdmin() || (
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'idade', 'nascimento', 'pos', 'foto']) &&
        fotoOk());
      allow delete: if isAdmin();
    }

    // Nota e velocidade: só admin enxerga e altera.
    match /ratings/{uid} {
      allow read, write: if isAdmin();
    }

    // Relatos de problemas: qualquer usuário logado envia; só admin lê e gerencia.
    match /problemas/{id} {
      allow create: if signed() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.texto is string &&
        request.resource.data.texto.size() > 0 &&
        request.resource.data.texto.size() <= 1000;
      allow read, update, delete: if isAdmin();
    }

    // Contatos para notificação: só admin.
    match /config/{doc} {
      allow read, write: if isAdmin();
    }

    // Peladas: todos leem, só admin cria/edita.
    match /peladas/{pid} {
      allow read: if signed();
      allow write: if isAdmin();

      // Votação de notas: só participantes, só até o prazo, só em jogadores da pelada, nunca em si mesmo.
      // Cada um lê apenas o próprio voto; admin lê todos (e só ele vê as médias).
      match /votos/{voter} {
        allow get: if isAdmin() || request.auth.uid == voter;
        allow list: if isAdmin();
        allow create, update: if request.auth.uid == voter &&
          get(/databases/$(database)/documents/peladas/$(pid)).data.status == 'finalizada' &&
          request.time.toMillis() < get(/databases/$(database)/documents/peladas/$(pid)).data.votacaoAte &&
          request.auth.uid in get(/databases/$(database)/documents/peladas/$(pid)).data.participantes &&
          request.resource.data.notas.keys().hasOnly(get(/databases/$(database)/documents/peladas/$(pid)).data.participantes) &&
          !(request.auth.uid in request.resource.data.notas.keys());
        allow delete: if isAdmin();
      }

      // Decisões do admin sobre as notas propostas.
      match /decisoes/{uid} {
        allow read, write: if isAdmin();
      }

      // Presença: cada um muda a própria (só com a pelada aberta); admin muda a de qualquer um.
      match /rsvps/{uid} {
        allow read: if signed();
        allow create, update: if isAdmin() || (
          request.auth.uid == uid &&
          request.resource.data.by == uid &&
          request.resource.data.intent in ['dentro', 'fora'] &&
          get(/databases/$(database)/documents/peladas/$(pid)).data.status == 'aberta');
        allow delete: if isAdmin();
      }
    }
  }
}
